# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv
.tmp

# Training Videos
videos
outputs

# Models (root-level checkpoint output dir only — do NOT drop the leading
# slash, or this also matches src/models/ and silently untracks the code there)
/models

# API Keys
.env

# W&B Experiment Run Files
wandb

# SLURM batch job logs (train.slurm/sweep_models.slurm/sweep_archs.slurm: #SBATCH --output/--error)
*.out
*.err
logs
multirun
# trm-delay-robust-scaling: Phase 3-4 raw run results stay out of git (multi-GB); the analysis
# JSONs, figures and reports that cite them are tracked. Stage D's C headers are a deliverable.
projects/trm-delay-robust-scaling/phase3/results/
projects/trm-delay-robust-scaling/phase4/results/*
!projects/trm-delay-robust-scaling/phase4/results/export_c/
# LaTeX build logs
projects/**/*.log
